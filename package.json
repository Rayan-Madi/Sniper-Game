{
  "name": "sniper-game",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pvp-server": "cd server && npm start",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.sniper.game",
    "productName": "Sniper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "public/icon.png",
      "shortcutName": "Sniper"
    }
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.0"
  }
}
