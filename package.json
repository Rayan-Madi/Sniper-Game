{
  "name": "sniper-game",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pvp-server": "cd server && npm start",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && electron-builder",
    "dist": "vite build && electron-builder --win",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.sniper.game",
    "productName": "Sniper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Sniper"
    }
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "vite": "^8.1.0",
    "vitest": "^5.0.3"
  }
}
